{%- comment -%}
  EvlveX footer. Replaces Dawn's footer in sections/footer-group.json (sections/footer.liquid stays as a fallback).
  Order: statement + newsletter · link columns (accordions on mobile) and contact · full-width wordmark · legal bar.
  Each thing appears once: one newsletter, one set of social icons, one brand line. Spec: docs/spec/theme.md §3.
{%- endcomment -%}
{{ 'section-evlvex-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_social_icons = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_snapchat_link != blank or settings.social_tumblr_link != blank or settings.social_vimeo_link != blank
    assign has_social_icons = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="evx-footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.statement != blank or section.settings.newsletter_enable -%}
      <div class="evx-footer__top">
        <div class="evx-footer__statement">
          {%- if section.settings.statement != blank -%}
            <p class="evx-footer__statement-title">{{ section.settings.statement }}</p>
          {%- endif -%}
          {%- if section.settings.statement_text != blank -%}
            <p class="evx-footer__statement-text">{{ section.settings.statement_text }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.newsletter_enable -%}
          <div class="evx-footer__newsletter">
            {%- if section.settings.newsletter_heading != blank -%}
              <h2 class="evx-footer__heading" id="EvxFooterNewsletter-{{ section.id }}">
                {{ section.settings.newsletter_heading }}
              </h2>
            {%- endif -%}
            {%- form 'customer', id: 'ContactFooter', class: 'evx-footer__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="evx-footer__field">
                <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">{{ 'newsletter.label' | t }}</label>
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="evx-footer__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="ContactFooter-error"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="ContactFooter-success"
                  {% endif %}
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Your email' | escape }}"
                  required
                >
                <button type="submit" class="evx-footer__submit" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                  <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                </button>
              </div>
              {%- if form.errors -%}
                <p class="evx-footer__form-message" id="ContactFooter-error">
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </p>
              {%- elsif form.posted_successfully? -%}
                <p class="evx-footer__form-message" id="ContactFooter-success" tabindex="-1" autofocus>
                  {{- 'newsletter.success' | t -}}
                </p>
              {%- elsif section.settings.newsletter_note != blank -%}
                <p class="evx-footer__note">{{ section.settings.newsletter_note }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="evx-footer__grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'column' -%}
              <details class="evx-footer__col" {{ block.shopify_attributes }} data-evx-footer-col>
                <summary class="evx-footer__summary">
                  <h2 class="evx-footer__heading">{{ block.settings.heading }}</h2>
                  <span class="evx-footer__toggle" aria-hidden="true"></span>
                </summary>
                <div class="evx-footer__links">
                  {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                    <ul class="list-unstyled" role="list">
                      {%- for link in block.settings.menu.links -%}
                        <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    <div class="evx-footer__rte">{{ block.settings.links }}</div>
                  {%- endif -%}
                </div>
              </details>

            {%- when 'contact' -%}
              <div class="evx-footer__col evx-footer__col--contact" {{ block.shopify_attributes }}>
                <h2 class="evx-footer__heading">{{ block.settings.heading }}</h2>
                <dl class="evx-footer__contact">
                  {%- if block.settings.email != blank -%}
                    <div>
                      <dt>Support</dt>
                      <dd><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></dd>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.instagram_handle != blank -%}
                    <div>
                      <dt>Instagram</dt>
                      <dd>
                        <a href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/evlvex' }}" target="_blank" rel="noopener">
                          {{- block.settings.instagram_handle -}}
                        </a>
                      </dd>
                    </div>
                  {%- endif -%}
                </dl>
                {%- if block.settings.note != blank -%}
                  <p class="evx-footer__note">{{ block.settings.note }}</p>
                {%- endif -%}
                {%- if block.settings.show_social and has_social_icons -%}
                  {%- render 'social-icons', class: 'evx-footer__social' -%}
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <a href="{{ routes.root_url }}" class="evx-footer__wordmark" aria-label="{{ shop.name | escape }}">
        {%- render 'evlvex-wordmark' -%}
      </a>
    {%- endif -%}

    <div class="evx-footer__bottom">
      <p class="evx-footer__legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: 'EvlveX' }}</span>
        {%- if section.settings.origin != blank -%}
          <span>{{ section.settings.origin }}</span>
        {%- endif -%}
        {%- if section.settings.trust_line != blank -%}
          <span>{{ section.settings.trust_line }}</span>
        {%- endif -%}
      </p>

      {%- if section.settings.show_policy -%}
        <ul class="evx-footer__policies list-unstyled" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="evx-footer__meta">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="evx-footer__country">
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- else -%}
          <span class="evx-footer__country-static">
            {{- localization.country.name }} · {{ localization.country.currency.iso_code }}
            {{ localization.country.currency.symbol -}}
          </span>
        {%- endif -%}

        {%- if section.settings.payment_enable and shop.enabled_payment_types.size > 0 -%}
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          <ul class="list list-payment evx-footer__payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

<script>
  // Footer link columns are accordions on mobile only: open them on wider screens.
  (function () {
    var mq = window.matchMedia('(min-width: 750px)');
    function sync() {
      document.querySelectorAll('[data-evx-footer-col]').forEach(function (el) {
        if (mq.matches) el.setAttribute('open', '');
        else el.removeAttribute('open');
      });
    }
    sync();
    if (mq.addEventListener) mq.addEventListener('change', sync);
  })();
</script>

{% schema %}
{
  "name": "EvlveX footer",
  "class": "section-evlvex-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 5,
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Optional. When a menu is chosen it replaces the links below." },
        {
          "type": "richtext",
          "id": "links",
          "label": "Links",
          "info": "One link per paragraph.",
          "default": "<p><a href=\"/collections/all\">The Collection</a></p>"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
        { "type": "text", "id": "email", "label": "Support email", "default": "support@evlvex.in" },
        { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "@evlvex", "info": "Links to the Instagram URL in Theme settings → Social media." },
        { "type": "text", "id": "note", "label": "Note", "default": "We answer within one working day." },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true }
      ]
    }
  ],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "header", "content": "Statement" },
    { "type": "text", "id": "statement", "label": "Statement", "default": "Falling behind is not the end." },
    { "type": "text", "id": "statement_text", "label": "Line under the statement", "default": "Sometimes, it is where the comeback begins." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "newsletter_enable", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "New chapters, first" },
    { "type": "text", "id": "newsletter_placeholder", "label": "Field placeholder", "default": "Your email" },
    { "type": "text", "id": "newsletter_note", "label": "Note", "default": "One letter per chapter. Nothing else." },
    { "type": "header", "content": "Brand" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show full-width wordmark", "default": true },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "EvlveX" },
    { "type": "text", "id": "origin", "label": "Origin", "default": "Made in India" },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "evlvex.in is the only official EvlveX store." },
    { "type": "checkbox", "id": "show_policy", "label": "Show policy links", "default": true },
    { "type": "checkbox", "id": "enable_country_selector", "label": "Show country selector", "info": "Shows a selector when more than one country is enabled; otherwise the country and currency as text.", "default": true },
    { "type": "checkbox", "id": "payment_enable", "label": "Show payment icons", "default": true },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 32 }
  ],
  "presets": [
    {
      "name": "EvlveX footer",
      "blocks": [
        { "type": "column" },
        { "type": "contact" }
      ]
    }
  ]
}
{% endschema %}
