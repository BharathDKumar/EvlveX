{%- comment -%}
  EvlveX size guide table (templates/page.size-guide.json). One "size" block per row; edit rows in the theme editor.
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .evx-size-guide__inner {
    max-width: 82rem;
    margin: 0 auto;
  }
  .evx-size-guide__heading {
    margin: 0 0 1.2rem;
  }
  .evx-size-guide__intro {
    margin: 0 0 3.2rem;
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.75);
  }
  .evx-size-guide__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .evx-size-guide__table {
    width: 100%;
    min-width: 48rem;
    border-collapse: collapse;
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  .evx-size-guide__table th,
  .evx-size-guide__table td {
    padding: 1.4rem 1.2rem;
    text-align: left;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.12);
  }
  .evx-size-guide__table thead th {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 2px solid rgb(var(--color-foreground));
  }
  .evx-size-guide__table tbody th {
    font-weight: 700;
  }
  .evx-size-guide__table tbody tr:hover {
    background: rgba(var(--color-foreground), 0.04);
  }
  .evx-size-guide__note {
    margin: 2.4rem 0 0;
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.75);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="evx-size-guide__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="evx-size-guide__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="evx-size-guide__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      <div class="evx-size-guide__scroll">
        <table class="evx-size-guide__table">
          <thead>
            <tr>
              <th scope="col">{{ section.settings.label_uk | escape }}</th>
              <th scope="col">{{ section.settings.label_eu | escape }}</th>
              <th scope="col">{{ section.settings.label_us | escape }}</th>
              <th scope="col">{{ section.settings.label_cm | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.uk | escape }}</th>
                <td>{{ block.settings.eu | escape }}</td>
                <td>{{ block.settings.us | escape }}</td>
                <td>{{ block.settings.cm | escape }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      {%- if section.settings.note != blank -%}
        <div class="evx-size-guide__note rte">{{ section.settings.note }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "EvlveX size guide",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "size",
      "name": "Size row",
      "settings": [
        { "type": "text", "id": "uk", "label": "UK / India", "default": "UK 8" },
        { "type": "text", "id": "eu", "label": "EU", "default": "42" },
        { "type": "text", "id": "us", "label": "US", "default": "9" },
        { "type": "text", "id": "cm", "label": "Foot length", "default": "26.2 cm" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size chart" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "label_uk", "label": "Column 1 label", "default": "UK / India" },
    { "type": "text", "id": "label_eu", "label": "Column 2 label", "default": "EU" },
    { "type": "text", "id": "label_us", "label": "Column 3 label", "default": "US" },
    { "type": "text", "id": "label_cm", "label": "Column 4 label", "default": "Foot length" },
    { "type": "richtext", "id": "note", "label": "Note under the table" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 52 }
  ],
  "presets": [
    {
      "name": "EvlveX size guide",
      "blocks": [{ "type": "size" }]
    }
  ]
}
{% endschema %}
