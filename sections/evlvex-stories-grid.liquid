{%- comment -%}
  EvlveX — grid of story cards, newest chapter first.
  Home page "The Stories" (3 cards) and The Stories index page (all). Spec: docs/spec/theme.md §4.
{%- endcomment -%}

{{ 'evlvex-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  capture story_handles
    render 'evlvex-story-handles'
  endcapture
  assign story_handles = story_handles | strip | split: ','
  if section.settings.show_all
    assign story_limit = 50
  else
    assign story_limit = section.settings.limit
  endif
  case section.settings.columns_desktop
    when 2
      assign card_sizes = '(min-width: 990px) 50vw, (min-width: 750px) 50vw, 85vw'
    when 4
      assign card_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 85vw'
    else
      assign card_sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw'
  endcase
-%}

{%- if story_handles.size > 0 or request.design_mode -%}
  <div class="evx-stories color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if section.settings.caption != blank or section.settings.heading != blank or section.settings.text != blank -%}
        <div class="evx-stories__header">
          {%- if section.settings.caption != blank -%}
            <p class="evx-eyebrow">{{ section.settings.caption | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="evx-stories__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="evx-stories__intro rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if story_handles.size > 0 -%}
        <ul
          class="evx-stories__grid evx-stories__grid--{{ section.settings.columns_desktop }}{% if section.settings.swipe_on_mobile %} evx-stories__grid--swipe{% endif %} list-unstyled"
          role="list"
        >
          {%- for handle in story_handles limit: story_limit -%}
            {%- assign story = shop.metaobjects.evlvex_story[handle] -%}
            {%- if story != blank -%}
              <li class="evx-stories__item">
                {%- liquid
                  if forloop.index <= section.settings.columns_desktop
                    assign eager = true
                  else
                    assign eager = false
                  endif
                  render 'evlvex-story-card', story: story, sizes: card_sizes, eager: eager
                -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="evx-stories__empty">
          No stories yet. Add entries in Content → Metaobjects → EvlveX Story and set them to Active.
        </p>
      {%- endif -%}

      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <div class="evx-stories__footer">
          <a class="button button--secondary" href="{{ section.settings.link }}">
            {{- section.settings.link_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "EvlveX stories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Eyebrow",
      "default": "The Stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every pair has a story"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "header",
      "content": "Stories"
    },
    {
      "type": "paragraph",
      "content": "Shows active EvlveX Story entries, newest chapter first."
    },
    {
      "type": "checkbox",
      "id": "show_all",
      "label": "Show all stories",
      "default": false
    },
    {
      "type": "range",
      "id": "limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Number of stories",
      "info": "Ignored when \"Show all stories\" is on.",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "Swipe on mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read all the stories"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "EvlveX stories"
    }
  ]
}
{% endschema %}
