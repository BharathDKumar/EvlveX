<style type="text/css">
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }

  .template-404__mark {
    color: rgb(184, 155, 106);
    margin-bottom: 2rem;
  }

  .template-404__serial {
    margin-top: 3.2rem;
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.75);
  }
</style>

<div class="template-404 page-width page-margin center">
  {%- render 'evlvex-monogram', size: 56, class: 'template-404__mark' -%}
  <p class="caption-with-letter-spacing">
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {%- if section.settings.heading != blank -%}
      {{ section.settings.heading | escape }}
    {%- else -%}
      {{ 'templates.404.title' | t }}
    {%- endif -%}
  </h1>
  <a href="{{ section.settings.button_link | default: routes.root_url }}" class="button">
    {%- if section.settings.button_label != blank -%}
      {{ section.settings.button_label | escape }}
    {%- else -%}
      {{ 'general.continue_shopping' | t }}
    {%- endif -%}
  </a>
  <p class="template-404__serial">
    {{ 'evlvex.not_found.serial_html' | t: url: '/pages/authenticity' }}
  </p>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This page has no story yet."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Return to the Maison"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to the home page."
    }
  ]
}
{% endschema %}
