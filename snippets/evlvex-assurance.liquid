{%- doc -%}
  EvlveX: short assurance chips under the buy buttons (main-product block "EvlveX assurance", Street Drop v1.13).
  Only lines that are true for every order belong here (docs/spec/brand-and-content.md §4).

  @param {object} block - The main-product block (settings line_1, line_2, line_3)

  @example
  {% render 'evlvex-assurance', block: block %}
{%- enddoc -%}
<ul class="sd-assure" {{ block.shopify_attributes }}>
  {%- if block.settings.line_1 != blank -%}<li>{{ block.settings.line_1 | escape }}</li>{%- endif -%}
  {%- if block.settings.line_2 != blank -%}<li>{{ block.settings.line_2 | escape }}</li>{%- endif -%}
  {%- if block.settings.line_3 != blank -%}<li>{{ block.settings.line_3 | escape }}</li>{%- endif -%}
</ul>
