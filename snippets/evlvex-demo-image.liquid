{%- doc -%}
  EvlveX shoe imagery: graded photographs of the two COMEBACK models (The Silent Grind, black; A Fresh Start, cream),
  shown wherever no image has been chosen yet, instead of Dawn's placeholder illustrations.
  Source photos and crops: docs/brand/shoe-images.md. Controlled by Theme settings → EvlveX → "Show demo photography"
  (settings.evx_demo_images); when that is off, the EvlveX monogram plate is shown instead.

  @param {string} kind - 'hero', 'editorial', 'lifestyle', 'atelier', 'product', 'collection' or 'article'
  @param {string} [seed] - Number or text used to pick an image from the pool, so neighbouring cards differ
  @param {string} [shoe] - 'silent-grind' or 'fresh-start': show only that model's crops from the pool
  @param {string} [sizes] - sizes attribute (default 100vw)
  @param {string} [loading] - 'lazy' (default) or 'eager'
  @param {string} [fetchpriority] - 'auto' (default) or 'high'
  @param {string} [class] - Extra classes for the img
  @param {string} [alt] - Alt text override

  @example
  {% render 'evlvex-demo-image', kind: 'product', seed: card_product.id, sizes: '50vw' %}
{%- enddoc -%}
{%- if settings.evx_demo_images -%}
  {%- liquid
    assign sg_full = 'evx-sg-full|1600|1067|The Silent Grind: black low-top sneaker with the white EvlveX monogram, side view'
    assign sg_card = 'evx-sg-card|1200|1500|The Silent Grind: black low-top sneaker with the white EvlveX monogram'
    assign sg_mono = 'evx-sg-monogram|1000|1120|The embroidered white EvlveX monogram on The Silent Grind'
    assign sg_sole = 'evx-sg-sole|1600|1067|The Silent Grind: the NEVER GIVE UP heel and the black and white outsole'
    assign sg_heel = 'evx-sg-heel|1600|1067|NEVER GIVE UP on the heel of The Silent Grind'
    assign sg_hold = 'evx-sg-hold|1200|1500|The Silent Grind held to the chest, monogram in the light'
    assign sg_duo = 'evx-sg-duo|1600|1200|The Silent Grind from above and from the side'
    assign fs_full = 'evx-fs-full|1600|900|A Fresh Start: cream and sand low-top sneaker with an embossed EvlveX monogram'
    assign fs_card = 'evx-fs-card|1200|1500|A Fresh Start: cream and sand low-top sneaker on a gum sole'
    assign fs_wide = 'evx-fs-wide|1600|1200|A Fresh Start: cream and sand low-top sneaker with an embossed EvlveX monogram'
    assign fs_mono = 'evx-fs-monogram|1000|760|The embossed EvlveX monogram on A Fresh Start'
    assign fs_lace = 'evx-fs-laces|1000|1500|A Fresh Start from above: sand laces and the EvlveX tongue'
    assign fs_heel = 'evx-fs-heel|1600|1067|NEVER GIVE UP on the heel of A Fresh Start'
    assign pair = 'evx-comeback-pair|1600|1067|COMEBACK Series 01: The Silent Grind and A Fresh Start with the COMEBACK card'
    assign card = 'evx-comeback-card|1600|1067|The COMEBACK Series 01 card'
    assign box = 'evx-box|1600|1067|The black EvlveX box on satin'
    assign box_streak = 'evx-box-streak|1600|1067|The EvlveX box lid in a streak of light'

    case kind
      when 'hero'
        assign demo_pool = pair | append: ';' | append: sg_full | append: ';' | append: fs_wide | append: ';' | append: sg_duo
      when 'lifestyle'
        assign demo_pool = sg_hold | append: ';' | append: sg_duo | append: ';' | append: fs_full | append: ';' | append: sg_full | append: ';' | append: fs_lace
      when 'atelier'
        assign demo_pool = sg_mono | append: ';' | append: fs_mono | append: ';' | append: sg_heel | append: ';' | append: fs_heel | append: ';' | append: box | append: ';' | append: sg_sole | append: ';' | append: fs_lace
      when 'product'
        assign demo_pool = sg_card | append: ';' | append: fs_card
      when 'collection'
        assign demo_pool = pair | append: ';' | append: sg_card | append: ';' | append: fs_card | append: ';' | append: box
      when 'article'
        assign demo_pool = sg_full | append: ';' | append: fs_wide | append: ';' | append: card | append: ';' | append: box_streak | append: ';' | append: sg_heel
      else
        assign demo_pool = sg_full | append: ';' | append: fs_wide | append: ';' | append: sg_hold | append: ';' | append: fs_lace | append: ';' | append: pair
    endcase

    assign demo_items = demo_pool | split: ';'

    # Pin one model: keep only that model's crops from the pool (unchanged if the pool has none of them).
    case shoe
      when 'silent-grind'
        assign demo_prefix = 'evx-sg-'
      when 'fresh-start'
        assign demo_prefix = 'evx-fs-'
      else
        assign demo_prefix = ''
    endcase
    if demo_prefix != ''
      assign demo_kept = ''
      for demo_item in demo_items
        if demo_item contains demo_prefix
          assign demo_kept = demo_kept | append: ';' | append: demo_item
        endif
      endfor
      if demo_kept != ''
        assign demo_items = demo_kept | remove_first: ';' | split: ';'
      endif
    endif

    assign demo_seed = seed | plus: 0
    if demo_seed == 0 and seed != blank
      assign demo_seed = seed | size
    endif
    assign demo_index = demo_seed | abs | modulo: demo_items.size
    assign demo_parts = demo_items[demo_index] | split: '|'
    assign demo_src = demo_parts[0] | append: '.jpg' | asset_url
    assign demo_alt = alt | default: demo_parts[3]
  -%}
  <img
    src="{{ demo_src }}"
    sizes="{{ sizes | default: '100vw' }}"
    width="{{ demo_parts[1] }}"
    height="{{ demo_parts[2] }}"
    alt="{{ demo_alt | escape }}"
    loading="{{ loading | default: 'lazy' }}"
    fetchpriority="{{ fetchpriority | default: 'auto' }}"
    class="evx-demo-image evx-demo-image--{{ kind }}{% if class != blank %} {{ class }}{% endif %}"
  >
{%- else -%}
  {%- render 'evlvex-story-plate', ratio: 'auto', class: 'evx-plate--fill' -%}
{%- endif -%}
