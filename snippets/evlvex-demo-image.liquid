{%- doc -%}
  EvlveX shoe imagery: graded photographs of the two COMEBACK models (The Silent Grind, black; A Fresh Start, cream),
  shown wherever no image has been chosen yet, instead of Dawn's placeholder illustrations.
  Source photos and crops: docs/brand/shoe-images.md. Controlled by Theme settings → EvlveX → "Show demo photography"
  (settings.evx_demo_images); when that is off, the EvlveX monogram plate is shown instead.

  @param {string} kind - 'hero', 'editorial', 'lifestyle', 'atelier', 'product', 'collection' or 'article'
  @param {string} [seed] - Number or text used to pick an image from the pool, so neighbouring cards differ
  @param {string} [sizes] - sizes attribute (default 100vw)
  @param {string} [loading] - 'lazy' (default) or 'eager'
  @param {string} [fetchpriority] - 'auto' (default) or 'high'
  @param {string} [class] - Extra classes for the img
  @param {string} [alt] - Alt text override

  @example
  {% render 'evlvex-demo-image', kind: 'product', seed: card_product.id, sizes: '50vw' %}
{%- enddoc -%}
{%- if settings.evx_demo_images -%}
  {%- liquid
    assign sg_full = 'evx-sg-full|1024|768|The Silent Grind: black leather sneaker with a suede toe and the white EvlveX monogram'
    assign sg_card = 'evx-sg-card|1024|1280|The Silent Grind: black leather sneaker with a suede toe and the white EvlveX monogram'
    assign sg_mono = 'evx-sg-monogram|480|480|The white EvlveX monogram on the side of The Silent Grind'
    assign sg_sole = 'evx-sg-sole|600|375|Suede toe and white cupsole of The Silent Grind'
    assign fs_full = 'evx-fs-full|768|1024|A Fresh Start: cream leather sneaker with sand suede and an embossed EvlveX monogram'
    assign fs_card = 'evx-fs-card|768|960|A Fresh Start: cream leather sneaker with sand suede and an embossed EvlveX monogram'
    assign fs_wide = 'evx-fs-wide|1366|1024|A Fresh Start: cream leather sneaker with sand suede and an embossed EvlveX monogram'
    assign fs_mono = 'evx-fs-monogram|400|400|The embossed EvlveX monogram on A Fresh Start'
    assign fs_lace = 'evx-fs-laces|400|500|Sand laces and suede panels of A Fresh Start'
    assign pair = 'evx-comeback-pair|1600|1000|COMEBACK: The Silent Grind in black and A Fresh Start in cream, side by side'

    case kind
      when 'hero'
        assign demo_pool = pair | append: ';' | append: sg_full | append: ';' | append: fs_wide
      when 'lifestyle'
        assign demo_pool = sg_sole | append: ';' | append: fs_lace | append: ';' | append: sg_full | append: ';' | append: fs_full
      when 'atelier'
        assign demo_pool = sg_mono | append: ';' | append: fs_mono | append: ';' | append: sg_sole | append: ';' | append: fs_lace
      when 'product'
        assign demo_pool = sg_card | append: ';' | append: fs_card
      when 'collection'
        assign demo_pool = pair | append: ';' | append: sg_card | append: ';' | append: fs_card
      when 'article'
        assign demo_pool = sg_full | append: ';' | append: fs_wide | append: ';' | append: sg_mono | append: ';' | append: fs_mono
      else
        assign demo_pool = sg_full | append: ';' | append: fs_wide | append: ';' | append: sg_mono | append: ';' | append: fs_lace
    endcase

    assign demo_items = demo_pool | split: ';'
    assign demo_seed = seed | plus: 0
    if demo_seed == 0 and seed != blank
      assign demo_seed = seed | size
    endif
    assign demo_index = demo_seed | abs | modulo: demo_items.size
    assign demo_parts = demo_items[demo_index] | split: '|'
    assign demo_src = demo_parts[0] | append: '.jpg' | asset_url
    assign demo_alt = alt | default: demo_parts[3]
  -%}
  <img
    src="{{ demo_src }}"
    sizes="{{ sizes | default: '100vw' }}"
    width="{{ demo_parts[1] }}"
    height="{{ demo_parts[2] }}"
    alt="{{ demo_alt | escape }}"
    loading="{{ loading | default: 'lazy' }}"
    fetchpriority="{{ fetchpriority | default: 'auto' }}"
    class="evx-demo-image evx-demo-image--{{ kind }}{% if class != blank %} {{ class }}{% endif %}"
  >
{%- else -%}
  {%- render 'evlvex-story-plate', ratio: 'auto', class: 'evx-plate--fill' -%}
{%- endif -%}
