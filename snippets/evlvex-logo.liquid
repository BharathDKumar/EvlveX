{%- comment -%}
  EvlveX logo lockup (monogram + wordmark). Used by the header (wordmark only) and the password page (full lockup)
  when no logo image is uploaded. Both marks are the original brand artwork (docs/brand/logos/) and take the
  surrounding text color.
  Accepts:
  - size: {Number} monogram size in px (default 34)
  - stacked: {Boolean} put the wordmark under the monogram
  - mark: {Boolean} show the monogram (default true); false shows the wordmark alone
{%- endcomment -%}
{%- assign mark_size = size | default: 34 -%}
{%- assign logo_title = shop.name | default: 'EvlveX' -%}
{%- assign show_mark = true -%}
{%- if mark == false -%}{%- assign show_mark = false -%}{%- endif -%}
<span class="evlvex-logo{% if stacked %} evlvex-logo--stacked{% endif %}{% unless show_mark %} evlvex-logo--word-only{% endunless %}">
  {%- if show_mark -%}
    {%- render 'evlvex-monogram', size: mark_size, class: 'evlvex-logo__mark' -%}
  {%- endif -%}
  {%- render 'evlvex-wordmark', class: 'evlvex-logo__word', title: logo_title -%}
</span>
