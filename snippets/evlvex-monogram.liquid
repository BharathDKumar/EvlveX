{%- comment -%}
  EvlveX monogram — two mirrored "E"s inside a ring. Inherits color via currentColor.
  Accepts:
  - size: {Number} pixel width/height (default 40)
  - class: {String} extra CSS classes
  - title: {String} accessible label; omit to render decoratively (aria-hidden)
  Usage: {% render 'evlvex-monogram', size: 56, class: 'certificate__seal', title: 'EvlveX' %}
{%- endcomment -%}
{%- liquid
  assign mono_size = size | default: 40
-%}
<svg
  class="evlvex-monogram{% if class != blank %} {{ class }}{% endif %}"
  width="{{ mono_size }}"
  height="{{ mono_size }}"
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  {% if title != blank %}role="img" aria-label="{{ title | escape }}"{% else %}aria-hidden="true" focusable="false"{% endif %}
>
  <circle cx="50" cy="50" r="45.5" fill="none" stroke="currentColor" stroke-width="5"/>
  <g fill="currentColor">
    <rect x="25" y="27" width="50" height="7"/>
    <rect x="25" y="66" width="50" height="7"/>
    <rect x="40" y="27" width="7" height="46"/>
    <rect x="53" y="27" width="7" height="46"/>
    <rect x="29" y="46.5" width="18" height="7"/>
    <rect x="53" y="46.5" width="18" height="7"/>
  </g>
</svg>
