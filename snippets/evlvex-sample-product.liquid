{%- doc -%}
  Title or price for a sample product card (snippets/card-product.liquid, shown when no product is chosen,
  e.g. a featured collection without a collection). With demo photography on (Theme settings → EvlveX), it shows
  a COMEBACK model name (matching the shoe photo for the same seed) and a believable price in the store currency. With it off, it shows Dawn's defaults.

  @param {string} part - 'title' or 'price'
  @param {number} [seed] - Sample index; picks the name and price (matches the demo photo for the same seed)
  @param {boolean} [placeholder] - Passed through to the price snippet when demo photography is off

  @example
  {% render 'evlvex-sample-product', part: 'title', seed: 2 %}
{%- enddoc -%}
{%- liquid
  assign sample_names = 'The Silent Grind — Noir|A Fresh Start — Sand' | split: '|'
  assign sample_prices = '189,189' | split: ','
  assign sample_index = seed | default: 0 | modulo: sample_names.size
-%}
{%- if settings.evx_demo_images -%}
  {%- if part == 'title' -%}
    {{ sample_names[sample_index] }}
  {%- else -%}
    {%- liquid
      assign sample_price = sample_prices[sample_index] | times: 100
      if shop.currency == 'INR'
        assign sample_price = sample_price | times: 82
      endif
    -%}
    <div class="price">
      <span class="price-item price-item--regular">{{ sample_price | money_without_trailing_zeros }}</span>
    </div>
  {%- endif -%}
{%- elsif part == 'title' -%}
  {{ 'onboarding.product_title' | t }}
{%- else -%}
  {% render 'price', placeholder: placeholder, show_compare_at_price: true %}
{%- endif -%}
