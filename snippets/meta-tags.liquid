{%- doc -%}
  Renders Open Graph and Twitter metadata for the current page.

  @param {string} [title] - Overrides page_title (EvlveX story pages)
  @param {string} [description] - Overrides page_description
  @param {object} [image] - Overrides page_image; an image or a media image

  @example
  {% render 'meta-tags' %}
{%- enddoc -%}
{%- liquid
  assign og_title = title | default: page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = description | default: page_description | default: shop.description | default: shop.name
  assign og_image = image | default: page_image
  assign og_image = og_image.preview_image | default: og_image

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url }}">
  <meta property="og:image:width" content="{{ og_image.width }}">
  <meta property="og:image:height" content="{{ og_image.height }}">
  {%- if og_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- else -%}
  {%- comment -%} EvlveX: pages without their own image (home, most pages) share a brand shoe photo, never a blank card. {%- endcomment -%}
  <meta property="og:image" content="https:{{ 'evx-fs-wide.jpg' | asset_url }}">
  <meta property="og:image:secure_url" content="https:{{ 'evx-fs-wide.jpg' | asset_url }}">
  <meta property="og:image:width" content="1366">
  <meta property="og:image:height" content="1024">
  <meta property="og:image:alt" content="{{ shop.name | escape }} sneakers">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
