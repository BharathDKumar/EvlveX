{
  "sections": {
    "main": {
      "type": "main-blog",
      "settings": {
        "layout": "grid",
        "show_image": true,
        "image_height": "large",
        "show_date": true,
        "show_author": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "intro": {
      "type": "rich-text",
      "blocks": {
        "b1": {
          "type": "caption",
          "settings": {
            "caption": "The Journal",
            "text_style": "caption-with-letter-spacing",
            "text_size": "small"
          }
        },
        "b2": {
          "type": "heading",
          "settings": {
            "heading": "Journal",
            "heading_size": "h1"
          }
        },
        "b3": {
          "type": "text",
          "settings": {
            "text": "<p>News, stories and care tips from EvlveX.</p>"
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3"
      ],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-1",
        "full_width": false,
        "padding_top": 80,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "intro",
    "main"
  ]
}
