            "focus_y": 50,
            "chapter_label": "The Silent Grind",
            "eyebrow": "Chapter 01",
            "heading": "The Silent Grind",
            "heading_size": "title",
            "text": "The chapters lived in the dark: the struggles, setbacks and battles that aren't always seen.\nThe Silent Grind is about holding on through the weight of those moments and finding the strength to rise from them.\nBlack, with the monogram in white. For the battles no one sees.",
            "button_label": "Shop The Silent Grind",
            "button_link": "shopify://products/the-silent-grind"
          }
        },
        "fresh": {
          "type": "scene",
          "settings": {
