        "grind": {
          "type": "column",
          "settings": {
            "title": "02 The Grind",
            "text": "<p>The quiet work no one sees: early starts, small wins, holding on when it would be easier to let go.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "turn": {
