        "heading": {
          "type": "heading",
          "settings": {
            "heading": "The Silent Grind",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>The chapters lived in the dark: the struggles, setbacks and battles that aren't always seen. Holding on through the weight of those moments, and finding the strength to rise from them. In black, with the monogram in white.</p>",
            "text_style": "body"
          }
        }
      },
