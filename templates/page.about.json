    "story": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Why EvlveX",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>EvlveX began with a simple idea: the sneaker you reach for every day deserves the same care as the finest shoe in your wardrobe. We design few models, choose honest materials, and finish every pair by hand.</p><p>Our name is a promise. A well-made pair evolves with you: the leather softens, the suede deepens, and the shoe becomes yours alone. That is why every EvlveX is numbered and registered to its owner.</p>"
          }
        }
      },
      "block_order": ["heading", "text"],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-1",
        "full_width": false,
        "padding_top": 96,
        "padding_bottom": 80
      }
    },
    "materials": {
      "type": "image-with-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "Materials",
            "text_style": "caption-with-letter-spacing",
            "text_size": "small"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Chosen to age beautifully",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Full-grain leather that takes on a patina, brushed suede with a soft hand, and a stitched cupsole built to be worn for years, not seasons.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": ["caption", "heading", "text"],
      "settings": {
        "height": "large",
        "desktop_image_width": "medium",
        "layout": "image_first",
        "image_behavior": "none",
        "content_layout": "no-overlap",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "mobile_content_alignment": "left",
        "section_color_scheme": "scheme-2",
        "color_scheme": "scheme-2",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "owner": {
      "type": "image-with-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "Ownership",
            "text_style": "caption-with-letter-spacing",
            "text_size": "small"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Numbered. Registered. Yours.",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Each pair carries a unique serial. When it leaves the Maison, its certificate is registered in your name, and a scan of the tag will always bring you back to it.</p>",
            "text_style": "body"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "button_label": "About authenticity",
            "button_link": "shopify://pages/authenticity",
            "button_style_secondary": true
          }
        }
      },
      "block_order": ["caption", "heading", "text", "button"],
      "settings": {
        "height": "large",
        "desktop_image_width": "medium",
        "layout": "text_first",
        "image_behavior": "none",
        "content_layout": "no-overlap",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "mobile_content_alignment": "left",
        "section_color_scheme": "scheme-1",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
