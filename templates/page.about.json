            "text_style": "caption-with-letter-spacing"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "A house built on restraint",
            "heading_size": "h0"
          }
        }
      },
      "block_order": ["caption", "heading"],
      "settings": {
        "image_overlay_opacity": 35,
        "image_height": "medium",
