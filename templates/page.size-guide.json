      "blocks": {
        "c1": {
          "type": "column",
          "settings": {
            "title": "1. Stand on paper",
            "text": "<p>Place a sheet of paper on a hard floor against a wall. Stand on it with your heel touching the wall, wearing the socks you usually wear.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "c2": {
          "type": "column",
          "settings": {
            "title": "2. Mark your longest toe",
            "text": "<p>Ask someone to mark the tip of your longest toe, or mark it yourself keeping the pencil straight up.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "c3": {
          "type": "column",
          "settings": {
            "title": "3. Measure and compare",
            "text": "<p>Measure from the wall to the mark in centimetres. Measure both feet and use the longer one, then find it in the chart above.</p>",
            "link_label": "",
            "link": ""
          }
        }
