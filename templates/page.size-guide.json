          "settings": {
            "title": "1. Stand on paper",
            "text": "<p>Place a piece of paper on a hard floor and stand on it with your heel lightly touching a flat wall.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "c2": {
          "type": "column",
          "settings": {
            "title": "2. Mark your longest toe",
            "text": "<p>Mark the tip of your longest toe on the paper, keeping the pencil straight up.</p>",
