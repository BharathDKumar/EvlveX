        "b2": {
          "type": "heading",
          "settings": {
            "heading": "Track your order",
            "heading_size": "h0"
          }
        },
        "b3": {
          "type": "text",
          "settings": {
            "text": "<p>Every order is tracked from our door to yours. Here is what happens after you check out.</p>"
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3"
      ],
