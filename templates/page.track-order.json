      }
    },
    "steps": {
      "type": "multicolumn",
      "blocks": {
        "c1": {
          "type": "column",
          "settings": {
            "title": "1. Order confirmed",
            "text": "<p>You receive an order confirmation email with your order number straight after checkout.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "c2": {
          "type": "column",
          "settings": {
            "title": "2. Dispatched",
            "text": "<p>Within 1–2 working days we pack and dispatch your pair, and email you (plus an SMS where available) the courier name and a tracking link.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "c3": {
          "type": "column",
          "settings": {
            "title": "3. Delivered",
            "text": "<p>Delivery usually takes 3–7 working days after dispatch. Your parcel is insured until it reaches you.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3"
      ],
      "settings": {
        "title": "",
        "heading_size": "h2",
        "image_width": "third",
        "image_ratio": "adapt",
        "button_label": "",
        "button_link": "",
