    "find": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "In your dispatch email",
            "icon": "truck",
            "row_content": "<p>Open the “Your order is on the way” email and tap <strong>Track your order</strong>. It opens the courier’s tracking page.</p>",
            "page": ""
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "In your account",
            "icon": "lock",
            "row_content": "<p>Log in with the email you used at checkout. Your orders and their status are under <a href=\"/account\" title=\"My account\">My account</a>.</p>",
            "page": ""
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "My order seems delayed",
            "icon": "stopwatch",
            "row_content": "<p>Tracking can take up to 24 hours to update after dispatch. If nothing has changed for 3 working days, write to <a href=\"mailto:support@evlvex.in\" title=\"Email customer support\">support@evlvex.in</a> with your order number and we’ll check with the courier.</p>",
            "page": ""
          }
        }
      },
