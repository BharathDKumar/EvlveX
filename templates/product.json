          "type": "collapsible_tab",
          "settings": {
            "heading": "Care",
            "icon": "washing",
            "content": "<p>Wipe leather with a soft, dry cloth. Brush suede gently in one direction and protect it with a suede spray before first wear. Store in the dust bag, away from direct sunlight. <a href=\"/pages/care\" title=\"Care guide\">Full care guide</a>.</p>",
            "page": ""
          }
