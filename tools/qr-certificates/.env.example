# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# Store's myshopify domain — used only for API calls.
SHOPIFY_STORE=w3wigc-de.myshopify.com

# Access to the store, from the app installed on it. Use ONE of:
#  a) the app's client ID + secret (Dev Dashboard apps): a short-lived token is fetched automatically, or
#  b) a fixed Admin API access token (shpat_…).
# Scopes: read_metaobjects, write_metaobjects, read_metaobject_definitions,
#         write_metaobject_definitions, read_orders, write_orders, read_products, write_products
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_API_VERSION=2026-10

# Public domain encoded in every printed QR code. Must be the store's PRIMARY domain.
# Confirm this BEFORE printing tags — printed codes cannot be changed.
PUBLIC_DOMAIN=evlvex.in

# Must match the metaobject definition (created by `npm run setup`).
METAOBJECT_TYPE=evlvex_certificate
URL_PREFIX=authentic

# Packing email sent by `npm run autopack` (optional locally; set as GitHub secrets for the scheduled job).
# Gmail: SMTP_USER = the Gmail address, SMTP_PASS = an app password (Google Account → Security →
# 2-Step Verification → App passwords). MAIL_TO = who receives it (default: SMTP_USER).
SMTP_USER=
SMTP_PASS=
MAIL_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
